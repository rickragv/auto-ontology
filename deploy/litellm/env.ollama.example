# SPDX-License-Identifier: Apache-2.0
# Backend settings for the Ollama preset of the LiteLLM gateway
# (docker-compose.litellm.yml with deploy/litellm/ollama.yaml).
#
# In .env, replace the model settings from .env.example (DEFAULT_MODELS_*,
# REASONING_*, NON_REASONING_*, EMBED_*, RERANK_*) with these lines, then:
#   docker compose -f docker-compose.yml -f docker-compose.litellm.yml up -d
#
# Every triplet is set in full, so no field falls back to a built-in NVIDIA
# endpoint. Model names are the gateway aliases from ollama.yaml. URLs use the
# in-network name "litellm"; for a backend run on the host (uv run ...), use
# http://127.0.0.1:4000 instead. Docker Compose and the backend's .env loader
# both expand ${LITELLM_MASTER_KEY}; another loader may need the key written out.

# --- Gateway ---
LITELLM_PRESET=ollama
# The gateway's only credential; the backend sends it as its API key below.
# Replace the placeholder, e.g. with the output of: echo "sk-$(openssl rand -hex 32)"
# The gateway refuses to start only when the key is unset, empty or a known
# example value, so it would accept this placeholder.
LITELLM_MASTER_KEY=change-me

# --- Chat ---
# The gateway speaks the OpenAI protocol, so both roles use the OpenAI-style
# client whatever the model is called.
REASONING_ENDPOINT=http://litellm:4000/v1
REASONING_API_KEY=${LITELLM_MASTER_KEY}
REASONING_MODEL=ao-chat
REASONING_CLIENT=openai

NON_REASONING_ENDPOINT=http://litellm:4000/v1
NON_REASONING_API_KEY=${LITELLM_MASTER_KEY}
NON_REASONING_MODEL=ao-chat
NON_REASONING_CLIENT=openai

# Turns thinking off on qwen3.5. Measured through the gateway: about 0.2 s and
# 2 tokens for a one-word answer with it, 3-4 s and 120-150 tokens without.
# Remove it to let the model think.
LLM_REASONING_EFFORT=none

# A single local GPU is slow and serves one request at a time. The upstream
# defaults (120 s per call, 6 at once) suit hosted endpoints. In the tested run
# on an 8 GB laptop GPU four calls took 152-262 s; these are the values it used.
LLM_INVOKE_TIMEOUT_S=600
LLM_MAX_INFLIGHT=2
SEMANTIC_LLM_MAX_INFLIGHT=2

# --- Embeddings ---
# The backend appends /embeddings to this URL itself.
EMBED_ENDPOINT=http://litellm:4000/v1
EMBED_API_KEY=${LITELLM_MASTER_KEY}
EMBED_MODEL=ao-embed
# bge-m3 returns 1024 dimensions. Ingest and query must use the same model.
EMBED_DIMENSIONS=1024

# --- Rerank ---
# Ollama has no rerank API, so rerank is off. "disabled" sends no request: the
# only caller, bridge-table owner selection, takes the first candidate Term.
# To enable it, add an ao-rerank model to the gateway config and set
# RERANK_ENDPOINT=http://litellm:4000/rerank.
RERANK_ENDPOINT=disabled
RERANK_API_KEY=${LITELLM_MASTER_KEY}
RERANK_MODEL=ao-rerank
