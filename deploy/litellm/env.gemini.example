# SPDX-License-Identifier: Apache-2.0
# Sanity-tested once on 2026-11-13 (one ingest, one compile, one question) on a paid
# Gemini key. Not load-tested; the free-tier notes below are from documentation.
#
# Backend settings for the Gemini preset of the LiteLLM gateway
# (docker-compose.litellm.yml with deploy/litellm/gemini.yaml).
#
# In .env, replace the model settings from .env.example (DEFAULT_MODELS_*,
# REASONING_*, NON_REASONING_*, EMBED_*, RERANK_*) with these lines, then:
#   docker compose -f docker-compose.yml -f docker-compose.litellm.yml up -d
#
# Every triplet is set in full, so no field falls back to a built-in NVIDIA
# endpoint. Model names are the gateway aliases from gemini.yaml. URLs use the
# in-network name "litellm"; for a backend run on the host (uv run ...), use
# http://127.0.0.1:4000 instead. Docker Compose and the backend's .env loader
# both expand ${LITELLM_MASTER_KEY}; another loader may need the key written out.
#
# Prompts, schema details and catalog text go to Google. Google's pricing page
# says free-tier content is used to improve its products; paid-tier content is
# not.

# --- Gateway ---
LITELLM_PRESET=gemini
# The gateway's only credential; the backend sends it as its API key below.
# Replace the placeholder, e.g. with the output of: echo "sk-$(openssl rand -hex 32)"
# The gateway refuses to start only when the key is unset, empty or a known
# example value, so it would accept this placeholder.
LITELLM_MASTER_KEY=change-me
# Used by the gateway only. The backend containers load .env too but do not
# read it. Create one at https://aistudio.google.com/apikey. Limits apply per
# Google Cloud project, not per key.
GEMINI_API_KEY=

# --- Chat ---
# The gateway speaks the OpenAI protocol, so both roles use the OpenAI-style
# client whatever the model is called.
REASONING_ENDPOINT=http://litellm:4000/v1
REASONING_API_KEY=${LITELLM_MASTER_KEY}
REASONING_MODEL=ao-chat
REASONING_CLIENT=openai

NON_REASONING_ENDPOINT=http://litellm:4000/v1
NON_REASONING_API_KEY=${LITELLM_MASTER_KEY}
NON_REASONING_MODEL=ao-chat
NON_REASONING_CLIENT=openai

# LLM_REASONING_EFFORT is left unset, so gemini-3.8-flash thinks at its default
# level. "none" maps to minimal, the lowest; low, medium and high
# ask for more;
# thinking tokens count against the backend's 8192-token output limit.
# LLM_INVOKE_TIMEOUT_S is left at the upstream 120 s, which suits a hosted model.

# Free tier: about 10 chat requests a minute and 500 a day were reported for
# gemini-3.5-flash-lite; no figure is known for gemini-3.8-flash (Google
# publishes per-project limits only in AI Studio). The stack makes calls faster than that even one at
# a time, and the backend retries a rate-limited chat call for only about 6 s,
# so compile steps can fail on the free tier. One call in flight per process
# keeps the overrun small. On a paid tier, remove both lines.
LLM_MAX_INFLIGHT=1
SEMANTIC_LLM_MAX_INFLIGHT=1

# --- Embeddings ---
# The backend appends /embeddings to this URL itself.
EMBED_ENDPOINT=http://litellm:4000/v1
EMBED_API_KEY=${LITELLM_MASTER_KEY}
EMBED_MODEL=ao-embed
# gemini.yaml asks gemini-embedding-001 for 768 dimensions. The two must
# match. Ingest and query must use the same model.
EMBED_DIMENSIONS=768
# Free tier: about 100 requests and 30,000 input tokens a minute for Gemini
# embeddings (third-party figures, unverified). Google does not say whether a
# batch of N texts counts as 1 request or N. These values send 10 texts per
# request, one request at a time per embedding call. One request then uses at
# most 10 of the 100 requests even if each text counts, and at most 20,480
# tokens even if every text hits the model's 2,048-token input limit, so a
# refused request fits once the minute has passed. A long ingest still goes
# over the per-minute limit; the backend retries each chunk up to 4 times,
# 15, 30 and 60 s apart. Each embedding call has its own limit, so parallel
# ingests add up. On a paid tier, remove both lines (upstream: 32 and 32).
EMBED_BATCH_SIZE=10
EMBED_MAX_CONCURRENT=1

# --- Rerank ---
# No rerank model in gemini.yaml, so rerank is off. "disabled" sends no
# request: the only caller, bridge-table owner selection, takes the first
# candidate Term. To enable it, add an ao-rerank model to the gateway config
# and set RERANK_ENDPOINT=http://litellm:4000/rerank.
RERANK_ENDPOINT=disabled
RERANK_API_KEY=${LITELLM_MASTER_KEY}
RERANK_MODEL=ao-rerank
